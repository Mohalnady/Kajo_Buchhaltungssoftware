{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kontor",
  "version": "0.1.0",
  "identifier": "de.kontor.buchhaltung",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kontor",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Kontor",
    "category": "Finance",
    "shortDescription": "Buchhaltung und Abrechnung für kleine Einzelhandelsbetriebe",
    "longDescription": "Kontor ist ein internes Buchhaltungs- und Abrechnungsprogramm für kleine Einzelhandelsbetriebe in Deutschland: Buchungen, Kassenbuch, Auswertungen (BWA, EÜR, USt-Voranmeldung), Personal und Zeiterfassung. Keine GoBD-Zertifizierung, kein Ersatz für eine TSE-Kasse, keine Lohnabrechnung im rechtlichen Sinn, keine Steuerberatung.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["German", "English"],
        "displayLanguageSelector": true
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Mohalnady/Kajo_Buchhaltungssoftware/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGMUREREMyMjE5OEZBMUEKUldRYStwZ2h3dDBkNzExaUpQaEJ6WERRaXVxenN5UVJHdkk4SFEvVldaUXg2d2hjVng4dDk4RGsK"
    }
  }
}
